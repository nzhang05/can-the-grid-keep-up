# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored, so your keys never reach GitHub.

# Free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional, for later versions (ERCOT Public API; may only work from US IPs)
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=
